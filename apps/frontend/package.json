{
  "name": "aircnc-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "typecheck": "tsc --pretty --noEmit",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "axios": "1.20.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mongodb": "4.17.2",
    "sass": "^1.108.2",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.0.0"
